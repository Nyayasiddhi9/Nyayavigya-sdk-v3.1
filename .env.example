# NyayaVighya Legal SDK v3.1 Environment Configuration
# Copy this file to .env and fill in your values

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
DATABASE_URL=postgresql://user:password@localhost:5432/nyayavighya
PGHOST=localhost
PGPORT=5432
PGUSER=your_user
PGPASSWORD=your_password
PGDATABASE=nyayavighya

# ==============================================
# SERVER CONFIGURATION
# ==============================================
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# ==============================================
# SECURITY
# ==============================================
JWT_SECRET=your-super-secure-jwt-secret-min-32-chars
SESSION_SECRET=your-session-secret-min-32-chars
EMAIL_ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# ==============================================
# LLM PROVIDERS (Required: At least one)
# ==============================================

# OpenAI (GPT-5.1, GPT-4.1, o3, o3-mini) - Primary for contract analysis, legal reasoning
OPENAI_API_KEY=sk-...

# Anthropic (Claude 4.5 Sonnet, Claude 4 Opus) - Best for case law analysis, legal reasoning
ANTHROPIC_API_KEY=sk-ant-...

# Google (Gemini 2.5 Pro - 2M context, Gemini 2.0 Flash) - Multi-language, large document support
GEMINI_API_KEY=AIza...

# ==============================================
# LEGAL-SPECIFIC API KEYS
# ==============================================

# Indian Kanoon - Indian case law database
INDIAN_KANOON_API_KEY=...

# SCC Online - Supreme Court cases
SCC_ONLINE_API_KEY=...

# CourtListener - US case law (for reference)
COURTLISTENER_API_KEY=...

# Manupatra - Legal database
MANUPATRA_API_KEY=...

# ==============================================
# INDIAN LANGUAGE SUPPORT
# ==============================================

# Sarvam AI (Sarvam 2.0, Sarvam Voice, Sarvam Legal) - 22 Indian languages
SARVAM_API_KEY=...

# ==============================================
# ADDITIONAL LLM PROVIDERS (Optional)
# ==============================================

# DeepSeek (DeepSeek V3, DeepSeek R1) - Cost-effective legal reasoning
DEEPSEEK_API_KEY=sk-...

# Perplexity (Sonar Pro 2, Sonar Reasoning) - Case law search with citations
PERPLEXITY_API_KEY=pplx-...

# Groq (LLaMA 3.3 70B) - Ultra-fast document processing (500 tok/s)
GROQ_API_KEY=gsk_...

# ==============================================
# PAYMENT PROVIDERS (Optional)
# ==============================================

# Razorpay (Indian payments)
RAZORPAY_KEY_ID=...
RAZORPAY_KEY_SECRET=...

# Stripe (International payments)
STRIPE_SECRET_KEY=sk_...

# ==============================================
# RATE LIMITING
# ==============================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ==============================================
# LOGGING
# ==============================================
LOG_LEVEL=info
ENABLE_AUDIT_LOGS=true
LEGAL_PRIVILEGE_PROTECTION=true
